{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/interpret.ts": {
      "maxDuration": 300,
      "regions": ["sin1"]
    },
    "api/hexagrams.ts": {
      "maxDuration": 10,
      "regions": ["sin1"]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
